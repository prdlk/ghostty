# Font Configuration
font-size = 11
font-family = VictorMono Nerd Font
background-blur = true

# Window Configuration
window-decoration = false
window-padding-x = 0
window-padding-y = 0
# Ghostty parks the cell remainder (window height mod cell height) under the
# last row, so the tmux status bar floats above the bottom edge. VictorMono
# 11pt gives 21px cells; one px less makes 20px cells, which divide the
# 1420px umbriel window on the ultrawide (71 rows) and leave no strip. Other
# window heights bring the strip back; extend-always is no alternative, it
# paints default-bg columns opaque against the translucent body.
adjust-cell-height = -1
background-opacity = 0.98

# Cursor Configuration
cursor-style = underline
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Ghostty is only a tmux client: tmux owns tabs (windows), splits (panes),
# sessions and persistence. `clear` drops every Ghostty default (tabs,
# splits, alt+N goto_tab, ctrl+alt+arrow goto_split) so those chords reach
# tmux; the ctrl+shift chords below drive tmux through its prefix2
# (\x02 = ctrl+b). Keep `clear` above every other keybind line.
keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+shift+period=reload_config
# shift+enter as CSI-u (ESC[13;2u), the newline-in-prompt key coding agents
# (omp, claude) read. Never \n: that is ctrl+j, tmux's pane-down key.
keybind = shift+enter=text:\x1b[13;2u

# command palette: ctrl+space is tmux's root-table C-Space (tmux-palette);
# sent explicitly as NUL so no keyboard-protocol mode can turn it into a CSI.
# ctrl+backspace is a second key for the same palette.
keybind = ctrl+space=text:\x00
keybind = ctrl+backspace=text:\x00
# project tasks palette (pj): tmux prefix t
keybind = ctrl+shift+p=text:\x02t
keybind = ctrl+shift+space=text:\x02t

# launchers (kitty's ctrl+shift chords), tmux prefix y/e/g/a
keybind = ctrl+shift+f=text:\x02y
keybind = ctrl+shift+e=text:\x02e
keybind = ctrl+shift+g=text:\x02g
keybind = ctrl+shift+a=text:\x02a

# tabs → tmux windows
keybind = ctrl+shift+t=text:\x02c
keybind = ctrl+shift+w=text:\x02k
keybind = ctrl+shift+r=text:\x02r
keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02p
keybind = ctrl+page_down=text:\x02n
keybind = ctrl+page_up=text:\x02p
keybind = ctrl+shift+arrow_right=text:\x02n
keybind = ctrl+shift+arrow_left=text:\x02p
keybind = ctrl+shift+k=text:\x02n
keybind = ctrl+shift+h=text:\x02p

# splits → tmux panes
keybind = ctrl+shift+l=text:\x02v
keybind = ctrl+shift+j=text:\x02h
keybind = ctrl+shift+x=text:\x02x

# session picker: tmux-palette's sessions palette (tmux-sessions) on prefix o
keybind = ctrl+shift+o=text:\x02o
keybind = super+enter=text:\x02o
keybind = ctrl+shift+enter=text:\x02z
keybind = ctrl+shift+z=text:\x02z

# scrollback, help (search scrollback: tmux prefix /)
keybind = ctrl+shift+page_up=text:\x02[
keybind = ctrl+shift+slash=text:\x02?
keybind = ctrl+shift+alt+,=text:\x02q

# sessions: quitting Ghostty detaches; the session lives on in tmux
keybind = ctrl+shift+n=text:\x02C
keybind = ctrl+shift+s=text:\x02s
keybind = ctrl+shift+q=text:\x02d

keybind = super+shift+enter=new_window

# Tab configuration
gtk-titlebar = false

quit-after-last-window-closed = false
quit-after-last-window-closed-delay = 5m
# Every window gets its own tmux session (~/.local/bin/ghostty-tmux): it
# reclaims the oldest detached session or starts a new one. The first window
# after boot starts the tmux server, and tmux-continuum restores the last
# saved sessions, so closing Ghostty (or rebooting) never loses the shells.
command = shell:$HOME/.local/bin/ghostty-tmux

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# Rando stuff
gtk-single-instance = true

# Colors: Noctalia's ghostty template writes themes/noctalia from the active
# shell palette (Monochrome) and reloads Ghostty on every theme change.
theme = noctalia
